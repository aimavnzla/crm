# Variables de entorno para AIMA CRM

# Entorno
NODE_ENV=production

# Base de datos (para desarrollo local)
# En Vercel, usarás una base de datos externa (Turso, PlanetScale, etc.)
# DATABASE_URL=file:./data/aima.db

# Puerto del servidor (desarrollo local)
PORT=3001

# Zona horaria
TZ=America/Caracas